# Frontend (Vite) — set these in Vercel Project Settings → Environment Variables
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_POSTHOG_KEY=phc_your_posthog_project_key
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Optional: leave empty for same-origin API (recommended behind a reverse proxy)
# VITE_API_URL=

# Backend (Express) — required for Supabase Auth mirroring / admin
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
PORT=3001
