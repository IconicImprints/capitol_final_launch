# Capitol Environment Variables
# Copy this file to .env.local for local development
# NEVER commit .env.local or any files containing real secrets

# PostgreSQL Database Configuration (REQUIRED)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=capitol
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# JWT Secret (REQUIRED - generate a random 32+ character string)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_generated_jwt_secret_here

# Server Configuration
PORT=3001
NODE_ENV=development

# Development Options
# Set to true to disable rate limiting in development
DISABLE_RATE_LIMIT=false

# Vercel Configuration (automatically set in production)
# VERCEL=true

# Supabase Configuration (if using Supabase)
# SUPABASE_URL=your_supabase_project_url
# SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Storage Configuration
# STORAGE_PROVIDER=local
# S3_BUCKET=your_bucket_name
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your_aws_access_key
# S3_SECRET_ACCESS_KEY=your_aws_secret_key
# S3_ENDPOINT=https://s3.amazonaws.com