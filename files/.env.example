# Capitol Environment Variables
# Copy this file to .env.local for local development
# NEVER commit .env.local or any files containing real secrets

# Supabase Configuration (REQUIRED)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# JWT Secret (for custom session management - optional if using Supabase Auth)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_generated_jwt_secret_here

# Server Configuration
PORT=3001
NODE_ENV=development

# Development Options
# Set to true to disable rate limiting in development
DISABLE_RATE_LIMIT=false

# Vercel Configuration (automatically set in production)
# VERCEL=true
